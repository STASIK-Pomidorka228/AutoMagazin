					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"price\": 59000,\n  \"power\": 480\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/cars/10",
							"host": ["{{base_url}}"],
							"path": ["api", "cars", "10"]
						},
						"description": "Частичное обновление (PATCH — можно указать только изменяемые поля). Только для ADMIN."
					},
					"response": [
						{
							"name": "Машина обновлена частично",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"id\": 10,\n  \"brand\": \"Tesla\",\n  \"model\": \"Model 3\",\n  \"name\": \"Tesla Model 3\",\n  \"price\": 59000,\n  \"volume\": 0.0,\n  \"power\": 480\n}"
						}
					]
				},
				{
					"name": "10. Удалить автомобиль (ADMIN)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/cars/10",
							"host": ["{{base_url}}"],
							"path": ["api", "cars", "10"]
