							"code": 200,
							"body": "{\n  \"users\": [\n    { \"id\": 1, \"username\": \"admin\", \"firstName\": \"John\", \"lastName\": \"Admin\", \"email\": \"admin@automagazin.ru\", \"role\": \"ADMIN\", \"birthDate\": \"1990-01-15\" },\n    { \"id\": 2, \"username\": \"user\", \"firstName\": \"Peter\", \"lastName\": \"User\", \"email\": \"user@automagazin.ru\", \"role\": \"USER\", \"birthDate\": \"1995-06-20\" }\n  ]\n}"
